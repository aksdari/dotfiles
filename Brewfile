# Everything the dotfiles assume exists. Install with `brew bundle` or ./bootstrap.sh.
#
# Aerospace is deliberately not listed: it lives in a third-party tap, and
# Homebrew requires you to trust that tap yourself. See the README.

# ── Shell ────────────────────────────────────────────────────────────────────
brew "zsh"
brew "starship"                    # prompt
brew "zsh-autosuggestions"         # ghost-text history suggestions
brew "zsh-fast-syntax-highlighting"
brew "atuin"                       # searchable, synced shell history
brew "zoxide"                      # smarter cd
brew "stow"                        # symlink manager for this repo

# ── Terminal core ────────────────────────────────────────────────────────────
brew "neovim"
brew "tmux"
brew "fzf"
brew "ripgrep"
brew "fd"
brew "bat"
brew "eza"
brew "jq"
brew "yq"
brew "tlrc"                        # tldr pages
brew "btop"
brew "wget"

# ── Git ──────────────────────────────────────────────────────────────────────
brew "git"
brew "git-delta"                   # diff pager used by ~/.config/git/config
brew "gh"
brew "lazygit"
brew "gitleaks"                    # secret scanning, run by the pre-commit hook

# ── Languages & formatters ───────────────────────────────────────────────────
brew "node"                        # needed by several LSP servers
brew "go"
brew "uv"                          # python toolchain
brew "shfmt"
brew "shellcheck"
brew "stylua"

# ── Apps & fonts ─────────────────────────────────────────────────────────────
cask "ghostty"
cask "wezterm"
cask "font-meslo-lg-nerd-font"
