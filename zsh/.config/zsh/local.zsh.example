# Copy to local.zsh (gitignored) for anything that should not leave this machine:
# SDK paths, work aliases, API tokens, per-host PATH entries.
#
#   cp local.zsh.example local.zsh
#
# Example — Google Cloud SDK:
# if [[ -f "$HOME/Downloads/google-cloud-sdk/path.zsh.inc" ]]; then
#   source "$HOME/Downloads/google-cloud-sdk/path.zsh.inc"
#   source "$HOME/Downloads/google-cloud-sdk/completion.zsh.inc"
# fi
#
# Example — pnpm:
# export PNPM_HOME="$HOME/Library/pnpm"
# path=("$PNPM_HOME" $path)
#
# Example — work overrides:
# export AWS_PROFILE="work"
# alias deploy="make deploy ENV=staging"
